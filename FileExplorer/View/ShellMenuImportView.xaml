<UserControl x:Class="FileExplorer.View.ShellMenuImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shellImport="clr-namespace:FileExplorer.Tools.ShellImport"
             xmlns:properties="clr-namespace:FileExplorer.Properties"
             MinWidth="720" MinHeight="320" Loaded="ShellMenuImportView_Loaded"
             KeyboardNavigation.TabNavigation="Continue">
    <Grid Margin="0,8,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
        <DockPanel LastChildFill="False">
            <TextBlock Text="{x:Static properties:Resources.ShellMenuExtension}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="80" Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
            <TextBlock Text="{x:Static properties:Resources.Search}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="SearchTextBox" Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,12,0" />
            <ComboBox Width="125" SelectedValue="{Binding ConversionFilter}" SelectedValuePath="Tag">
                <ComboBoxItem Content="{x:Static properties:Resources.ShellMenuAllLevels}" Tag="{x:Null}" IsSelected="True" />
                <ComboBoxItem Content="{x:Static properties:Resources.ShellMenuDirect}" Tag="{x:Static shellImport:ShellMenuConversionKind.Direct}" />
                <ComboBoxItem Content="{x:Static properties:Resources.ShellMenuNeedsReview}" Tag="{x:Static shellImport:ShellMenuConversionKind.NeedsReview}" />
                <ComboBoxItem Content="{x:Static properties:Resources.ShellMenuUnsupported}" Tag="{x:Static shellImport:ShellMenuConversionKind.Unsupported}" />
            </ComboBox>
            <CheckBox Content="{x:Static properties:Resources.ShellMenuOnlyExistingExecutables}"
                      IsChecked="{Binding OnlyExistingExecutables, Mode=TwoWay}" VerticalAlignment="Center"
                      Margin="12,0,0,0" />
            <Button Content="{x:Static properties:Resources.ShellMenuScan}" MinWidth="80" Margin="12,0,8,0" Click="ScanButton_Click" />
            <Button Content="{x:Static properties:Resources.Cancel}" MinWidth="80" Click="CancelButton_Click" IsEnabled="{Binding IsScanning}" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding ScopeOptions}" Margin="0,6,0,0" KeyboardNavigation.TabNavigation="Continue">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Margin="0,0,12,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleItems}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  IsReadOnly="False" SelectionMode="Single" HeadersVisibility="Column" IsTabStop="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{x:Static properties:Resources.ToolPresetAdd}" Width="48">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelect}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static properties:Resources.ShellMenuCreateCopy}" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding CreateDuplicate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsAlreadyImported}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static properties:Resources.Name}" Binding="{Binding Title}" Width="150" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuScope}" Binding="{Binding ScopeText}" Width="125" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuSource}" Binding="{Binding Source}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuConversionLevel}" Binding="{Binding ConversionKindText}" Width="115" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuOriginalCommand}" Binding="{Binding RawCommand}" Width="220" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuExpandedCommand}" Binding="{Binding ExpandedCommand}" Width="220" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuParsedExecutable}" Binding="{Binding ParsedExecutable}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuParsedArguments}" Binding="{Binding ParsedArguments}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuPlaceholderDetails}" Binding="{Binding PlaceholderSummary}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuConvertedPreview}" Binding="{Binding ConvertedCommandPreview}" Width="200" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.Application}"
                                    Binding="{Binding DraftApplication, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ToolPresetArguments}"
                                    Binding="{Binding DraftArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ShellMenuReason}" Binding="{Binding ReasonText}" Width="210" IsReadOnly="True" />
                <DataGridTemplateColumn Header="{x:Static properties:Resources.ShellMenuAcceptRisk}" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsReviewAccepted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsReviewItem}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{x:Static properties:Resources.Copy}" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{x:Static properties:Resources.Copy}" Padding="6,1" Tag="{Binding RawCommand}"
                                    Click="CopyRawCommand_Click" IsEnabled="{Binding CanCopyRawCommand}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ScanSummary}" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button Content="{x:Static properties:Resources.AddSelected}" MinWidth="110" HorizontalAlignment="Right"
                    Click="AddSelectedButton_Click" IsEnabled="{Binding CanCommitResults}" />
        </DockPanel>
    </Grid>
</UserControl>

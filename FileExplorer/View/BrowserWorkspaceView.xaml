<UserControl x:Class="FileExplorer.View.BrowserWorkspaceView"
             x:Name="Workspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
             xmlns:dxgt="http://schemas.devexpress.com/winfx/2008/xaml/grid/themekeys"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
             xmlns:common="clr-namespace:FileExplorer.Core"
             xmlns:controls="clr-namespace:FileExplorer.Controls"
             xmlns:view="clr-namespace:FileExplorer.View">
    <dxdo:DockLayoutManager AutoHideExpandMode="MouseDown" AutoHideMode="Inline"
                            Background="{DynamicResource {dxgt:LWKey TableView.DataPresenterBackground}}">
        <dxdo:LayoutGroup>
            <dxdo:LayoutPanel Padding="4" ShowCaption="False" ShowBorder="False" Background="Transparent"
                              Closed="{Binding ActiveTab.Settings.ShowNavigationPane, ElementName=Workspace, Converter={dxmvvm:BooleanNegationConverter}}"
                              MinWidth="120"
                              ItemWidth="{Binding ActiveTab.Settings.LeftPaneWidth, ElementName=Workspace, Mode=TwoWay, Delay=3000, Converter={common:NumericToGridLengthConverter}}">
                <ContentControl x:Name="NavigationHost">
                    <ContentControl.ContentTemplate>
                        <DataTemplate>
                            <dxb:BarManager>
                                <controls:FileTreeViewControl />
                            </dxb:BarManager>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </dxdo:LayoutPanel>
            <dxdo:LayoutGroup>
                <dxdo:LayoutPanel>
                    <dxdo:LayoutPanel.Template>
                        <ControlTemplate TargetType="dxdo:LayoutPanel">
                            <Border Margin="0,4,0,-3">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </dxdo:LayoutPanel.Template>
                    <ContentPresenter x:Name="ActiveContentPresenter" Content="{Binding ActiveTabContent, ElementName=Workspace}" />
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
            <dxdo:TabbedGroup x:Name="RightPaneGroup" TabContentCacheMode="CacheTabsOnSelecting"
                              Margin="{LWThemeValue Default='4,4,6,4', Win11='4'}"
                              AllowDrag="False" MinWidth="210"
                              ItemWidth="{Binding ActiveTab.Settings.RightPaneWidth, ElementName=Workspace, Mode=TwoWay, Delay=3000, Converter={common:NumericToGridLengthConverter}}">
                <dxdo:TabbedGroup.Visibility>
                    <MultiBinding Converter="{common:MultiBooleanToVisibilityConverter}">
                        <Binding Path="ActiveTab.Settings.ShowPreviewPane" ElementName="Workspace" />
                        <Binding Path="ActiveTab.Settings.ShowDetailsPane" ElementName="Workspace" />
                    </MultiBinding>
                </dxdo:TabbedGroup.Visibility>
                <dxdo:LayoutPanel Background="Transparent" Caption="{Binding PreviewPane, Source={StaticResource ResourceProvider}}"
                                  Closed="{Binding ActiveTab.Settings.ShowPreviewPane, ElementName=Workspace, Converter={dxmvvm:BooleanNegationConverter}}">
                    <ContentControl x:Name="PreviewHost">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <controls:PreviewControl File="{Binding ActiveFileList.SelectedItem, RelativeSource={RelativeSource AncestorType=view:BrowserWorkspaceView}}"
                                                         ErrorCommand="{Binding ShowExtensionsCommand}" />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </dxdo:LayoutPanel>
                <dxdo:LayoutPanel Background="Transparent" Caption="{Binding DetailsPane, Source={StaticResource ResourceProvider}}"
                                  Closed="{Binding ActiveTab.Settings.ShowDetailsPane, ElementName=Workspace, Converter={dxmvvm:BooleanNegationConverter}}">
                    <ContentControl x:Name="DetailsHost">
                        <ContentControl.ContentTemplate>
                            <DataTemplate>
                                <controls:FileDetailsControl VerticalAlignment="Center"
                                                             DataContext="{Binding ActiveFileList.CurrentItem, RelativeSource={RelativeSource AncestorType=view:BrowserWorkspaceView}}" />
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </dxdo:LayoutPanel>
            </dxdo:TabbedGroup>
        </dxdo:LayoutGroup>
    </dxdo:DockLayoutManager>
</UserControl>

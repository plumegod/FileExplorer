<UserControl x:Class="FileExplorer.View.ToolPresetSelectorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:properties="clr-namespace:FileExplorer.Properties"
             MinHeight="320" MinWidth="720">
    <Grid Margin="0,8,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DataGrid Grid.Row="0" ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                  HeadersVisibility="Column" SelectionMode="Single" IsTabStop="True" KeyboardNavigation.TabNavigation="Continue">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{x:Static properties:Resources.ToolPresetAdd}" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanSelect}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{x:Static properties:Resources.ToolPresetTool}" Binding="{Binding GroupName}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.Command}" Binding="{Binding DisplayName}" Width="130" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.Application}" Binding="{Binding ExecutablePath}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ToolPresetStatus}" Binding="{Binding StatusText}" Width="90" IsReadOnly="True" />
                <DataGridTextColumn Header="{x:Static properties:Resources.ToolPresetArguments}" Binding="{Binding CommandSummary}" Width="190" IsReadOnly="True" />
                <DataGridTemplateColumn Header="{x:Static properties:Resources.ToolPresetLocate}" Width="125">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static properties:Resources.Browse}" Padding="7,2" Margin="0,0,4,0" Tag="{Binding}" Click="Browse_Click" />
                                <Button Content="{x:Static properties:Resources.Clear}" Padding="7,2" Tag="{Binding}" Click="Clear_Click" IsEnabled="{Binding CanClearOverride}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="ResultText" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static properties:Resources.Refresh}" MinWidth="80" Margin="0,0,8,0" Click="Refresh_Click" />
                <Button Content="{x:Static properties:Resources.AddSelected}" MinWidth="105" Click="AddSelected_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>

<UserControl x:Class="FileExplorer.Controls.QuickPreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FileExplorer.Controls"
             xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm">

    <Border Padding="8"
            Background="{LWThemeValue Brush.Control.Background, Win11=Brush.WindowBackground}"
            BorderBrush="{LWThemeValue Brush.Border, Win11=Brush.PanelBorder}"
            BorderThickness="1"
            CornerRadius="6"
            SnapsToDevicePixels="True"
            UseLayoutRounding="True">
        <Grid Width="{Binding ContentWidth, RelativeSource={RelativeSource AncestorType=controls:QuickPreviewControl}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Width="{Binding PreviewWidth, RelativeSource={RelativeSource AncestorType=controls:QuickPreviewControl}}"
                    Height="{Binding PreviewHeight, RelativeSource={RelativeSource AncestorType=controls:QuickPreviewControl}}"
                    HorizontalAlignment="Center"
                    Background="{LWThemeValue Brush.Editor.Background}"
                    BorderBrush="{LWThemeValue Brush.Border, Win11=Brush.PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <Image Source="{Binding Snapshot.ImageSource, RelativeSource={RelativeSource AncestorType=controls:QuickPreviewControl}}"
                           Stretch="Uniform" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.72"
                               FontSize="12"
                               Text="No cached preview">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Snapshot.ImageSource, RelativeSource={RelativeSource AncestorType=controls:QuickPreviewControl}}" Value="{x:Null}" />
                                            <Condition Binding="{Binding Loading, RelativeSource={RelativeSource AncestorType=controls:QuickPreviewControl}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <ProgressBar Grid.Row="1" Margin="0,6,0,0" Height="2" IsIndeterminate="True"
                         Visibility="{Binding Loading, RelativeSource={RelativeSource AncestorType=controls:QuickPreviewControl}, Converter={dxmvvm:BooleanToVisibilityConverter}}" />

            <TextBlock Grid.Row="2"
                       Margin="0,6,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding FileName, RelativeSource={RelativeSource AncestorType=controls:QuickPreviewControl}}" />
        </Grid>
    </Border>
</UserControl>
